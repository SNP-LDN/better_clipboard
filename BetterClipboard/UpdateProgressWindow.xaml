<Window x:Class="BetterClipboard.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在更新 Better Clipboard"
        Icon="Assets/Brand/better-clipboard.ico"
        Width="390"
        Height="198"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusText"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <ProgressBar x:Name="DownloadProgress"
                     Grid.Row="1"
                     Height="12"
                     Margin="0,14,0,0"
                     Minimum="0"
                     Maximum="100" />
        <Grid Grid.Row="2" Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProgressText"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="0%" />
            <TextBlock x:Name="TransferredText"
                       Grid.Column="1"
                       Margin="12,0"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="正在连接…" />
            <TextBlock x:Name="SpeedText"
                       Grid.Column="2"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="-- MB/s" />
        </Grid>
        <TextBlock x:Name="DownloadPathText"
                   Grid.Row="3"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
